{
  "name": "storefront-mcp",
  "version": "1.0.1",
  "description": "MCP server template for e-commerce storefronts: public catalog tools for AI agents, token-gated back-office tools for you. Runs standalone via `npx storefront-mcp` (stdio) or as a Next.js App Router route.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "ecommerce",
    "ai-agents",
    "nextjs",
    "woocommerce"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Maarmapa/storefront-mcp.git"
  },
  "bin": {
    "storefront-mcp": "dist/src/cli/cli.js"
  },
  "files": [
    "dist",
    "server.json",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "build:cli": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build:cli",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "next": "^15.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.6.0"
  },
  "mcpName": "io.github.Maarmapa/storefront-mcp"
}
