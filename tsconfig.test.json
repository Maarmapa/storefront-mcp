{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist-test",
    "rootDir": ".",
    "module": "commonjs",
    "moduleResolution": "node",
    "incremental": false,
    "sourceMap": false,
    "declaration": false,
    "types": ["node"]
  },
  "include": ["src/lib/**/*.ts", "src/sdk/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "dist", "dist-test", "src/app"]
}
