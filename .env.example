# Which data source backs the catalog: memory | woocommerce
CATALOG_ADAPTER=memory

# Bearer token that unlocks the sensitive tools (orders, revenue, exact stock).
# Fail-closed: if unset, sensitive tools are blocked for everyone.
# HTTP transports check "Authorization: Bearer <MCP_SECRET>"; on stdio
# (`npx storefront-mcp`) the mere presence of the variable unlocks them.
# Generate one: openssl rand -hex 32
MCP_SECRET=

# Public identity of the server
MCP_SERVER_NAME=storefront-mcp
MCP_SERVER_DESCRIPTION=
# Your real site. Used to build the opt-in confirmation URL and the descriptor's
# docs link. There is no placeholder default: an unset value means those are
# omitted, not pointed at somebody else's domain.
NEXT_PUBLIC_SITE_URL=

# ── Who is calling ───────────────────────────────────────────────────────
# Name of the header YOUR edge writes with the real client IP. It is the only
# forwarding header this server will trust, because a forwarding header with no
# proxy in front of it is just text the caller typed — rotate it and you mint a
# fresh rate-limit bucket per request.
#   Vercel      → x-vercel-forwarded-for
#   Cloudflare  → cf-connecting-ip
#   Fly.io      → fly-client-ip
#   the bundled WordPress proxy → x-storefront-client-ip
# Setting it asserts that your edge OVERWRITES that header and that nothing
# else can reach this origin. If the origin is publicly reachable, anyone who
# finds it can forge the header — lock the origin down first.
# Unset: the socket address is used when the transport has one (the --http
# server), otherwise callers are not distinguished and the write quota becomes
# a ceiling for the whole instance instead of a per-caller limit.
TRUSTED_PROXY_HEADER=

# ── Write tools ──────────────────────────────────────────────────────────
# Both are PUBLIC (an agent is meant to be able to buy) and both are DRY
# until you turn them on by name. Dry runs every guard rail and then creates
# nothing, answering with what it would have done. Only the exact string
# "live" goes live, so a typo fails towards doing nothing. "off" removes the
# tool from tools/list entirely — that is the kill switch.
# A tool is announced only when the active adapter can honor it, so setting
# these on an adapter without the matching capability changes nothing.
CHECKOUT_MODE=dry
STOCK_ALERT_MODE=dry

# What live checkout does when the inventory adapter cannot HOLD units:
#   refuse (default) → no order is created, and the response explains why.
#   allow            → orders are created anyway. Read this before setting it:
#                      an availability CHECK cannot stop concurrent calls from
#                      selling the same units twice; only an atomic reservation
#                      can (InventoryAdapter.reserve). "allow" means you accept
#                      overselling under concurrency. Every receipt says so.
CHECKOUT_UNRESERVED=refuse

# HMAC key for double opt-in confirmation links, MINIMUM 32 characters.
# Missing or too short ⇒ no link can be issued and subscribe_stock_alert
# refuses; it never subscribes anyone without confirmation, and a guessable
# key would let anyone mint a token for someone else's address.
# Generate one: openssl rand -hex 32
STOCK_ALERT_SIGNING_SECRET=

# Public URL of the confirmation page (GET renders a button, POST writes).
# Defaults to ${NEXT_PUBLIC_SITE_URL}/api/stock-alert/confirm; with neither set,
# live mode sends NOTHING rather than mailing a link to a domain you do not own.
# `storefront-mcp --http` serves that page itself at /api/stock-alert/confirm.
STOCK_ALERT_CONFIRM_URL=

# Language of that page — the one screen in this project a customer sees.
# en | es
STOCK_ALERT_PAGE_LOCALE=en

# WooCommerce adapter only
WOO_BASE_URL=
STORE_CURRENCY=USD
