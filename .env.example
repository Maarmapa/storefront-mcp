# Which data source backs the catalog: memory | woocommerce
CATALOG_ADAPTER=memory

# Bearer token that unlocks the sensitive tools (orders, revenue, exact stock).
# Fail-closed: if unset, sensitive tools are blocked for everyone.
# HTTP transports check "Authorization: Bearer <MCP_SECRET>"; on stdio
# (`npx storefront-mcp`) the mere presence of the variable unlocks them.
# Generate one: openssl rand -hex 32
MCP_SECRET=

# Public identity of the server
MCP_SERVER_NAME=storefront-mcp
MCP_SERVER_DESCRIPTION=
NEXT_PUBLIC_SITE_URL=https://example.com

# WooCommerce adapter only
WOO_BASE_URL=
STORE_CURRENCY=USD
